 // One row against the n <= NC activations x + off[0..n) (n >= 1, warp-uniform; offsets in q8_1 blocks, 32-bit to
 // spare registers), the whole warp.  Per activation this is row_dot: the same calls k, lane-strided the same way,
 // summed in the same order, then the same warp_sum.  Only the weight side moves out of the per-activation loop.
+// TQ2_T rows staged per warp: the warp copies its whole row into shared memory with every lane's 4-byte copies in
+// flight at once (cp.async), then runs row_dot_multi's loop on the copy.  The loop decodes the same bytes in the same
+// order, so the result is bitwise the same; what changes is that the row costs one global-load round trip instead of
+// one per lane step (5 for Gyro-M's gate/up rows, 2 for its down rows).  On Orin the per-step load -> decode -> dp4a
+// chain left the expert kernels waiting on global loads (Nsight Compute: 63% of the gate/up stalls).  Keeping the
+// steps' bytes in registers instead doubled the kernels' registers and halved their occupancy (slower), hence shared
+// memory.  Rows of up to 32 blocks (4,096 values), at most 8 warps per block; anything else takes the plain loop.
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 800 && !defined(__HIPCC__)
+#define STRATA_TQ_CP_ASYNC 1
+#endif
+constexpr int kTqStageWarps = 8, kTqStageMaxBlocks = 32;
+constexpr int kTqStageWords = (3 + kTqStageMaxBlocks * (int) sizeof(block_tq2_t) + 3) / 4;
+template<int NC, bool EXACT_N>
+__device__ __forceinline__ bool row_dot_tq2t_staged(const uint8_t* row, const block_q8_1* x, const int (&off)[NC],
+                                                    int n, int nb, int lane, float (&s)[NC]) {
+    __shared__ alignas(16) uint32_t s_rows[kTqStageWarps][kTqStageWords];
+    const int nthreads = blockDim.x * blockDim.y * blockDim.z;
+    const int wid = (threadIdx.x + blockDim.x * (threadIdx.y + blockDim.y * threadIdx.z)) >> 5;
+    if (nb > kTqStageMaxBlocks || nthreads % 32 != 0 || wid >= kTqStageWarps) return false;   // warp-uniform
+    // aligned 4-byte words covering the row: the first and last may reach up to 3 bytes outside it, but stay inside
+    // the 4-byte-aligned words (and so the pages) that hold its first and last bytes
+    const uintptr_t a = (uintptr_t) row;
+    const int head = (int) (a & 3u);
+    const uint32_t* src = (const uint32_t*) (a - (uintptr_t) head);
+    const int words = (head + nb * (int) sizeof(block_tq2_t) + 3) >> 2;
+    uint32_t* dst = s_rows[wid];
+    for (int i = lane; i < words; i += 32) {
+#if defined(STRATA_TQ_CP_ASYNC)
+        const unsigned sa = (unsigned) __cvta_generic_to_shared(dst + i);
+        asm volatile("cp.async.ca.shared.global [%0], [%1], 4;\n" ::"r"(sa), "l"(src + i) : "memory");
+#else
+        dst[i] = src[i];
+#endif
+    }
+#if defined(STRATA_TQ_CP_ASYNC)
+    asm volatile("cp.async.commit_group;\n" ::: "memory");
+    asm volatile("cp.async.wait_group 0;\n" ::: "memory");
+#endif
+    __syncwarp();
+    const uint8_t* srow = (const uint8_t*) dst + head;   // same address parity as the row: 2-byte aligned blocks
+    using F = Fmt<144>;
+    using S = Split<144>;
+    for (int k = lane; k < nb * F::ipb; k += 32) {
+        const int kbx = k / F::ipb, iqs = F::step * (k % F::ipb);
+        const typename S::W w = S::template load<false>(srow, kbx, iqs, nullptr);
+#pragma unroll
+        for (int c = 0; c < NC; ++c)
+            if (EXACT_N || c < n) s[c] += S::apply(w, x + off[c] + kbx * (F::qk / 32), iqs);
+    }
+    __syncwarp();   // the warp's next row must not overwrite bytes a lagging lane still reads
+    return true;
+}
