-        const uint32_t x = (s[i] & TQ_STATE_MASK) * 0x9e3779b1u;
-        r.q[i] = (int) ((uint32_t) lut[x >> 21] | ((uint32_t) lut[(x >> 10) & 2047u] << 16));
+        for (int i = 0; i < 4; ++i) {
+            const uint32_t x = (s[i] & TQ_STATE_MASK) * 0x9e3779b1u;
+            r.q[i] = (int) ((uint32_t) lut[x >> 21] | ((uint32_t) lut[(x >> 10) & 2047u] << 16));
+        }
     }
     r.d = tq_h2f(b->d);
     return r;
