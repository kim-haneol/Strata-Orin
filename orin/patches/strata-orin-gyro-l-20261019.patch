                                           const uint16_t* __restrict__ lut = tq_lut_i8) {
     const auto* b = (const typename TqInfo<TY>::block_t*) vbq + kbx;
-    uint32_t s[4];
-    tq_states4<TY>(b->qs, iqs / 4, s);
