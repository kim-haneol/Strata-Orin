-#pragma unroll
-    for (int i = 0; i < 2; ++i) {
-        float2 a, c;
-        tq_step(s[2 * half + i], a, c);
-        y[4 * i + 0] = cvt<dst_t>(d * a.x);
-        y[4 * i + 1] = cvt<dst_t>(d * a.y);
-        y[4 * i + 2] = cvt<dst_t>(d * c.x);
