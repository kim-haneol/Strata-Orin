+    check(cudaMalloc(&d_bo, bo.size() * 4), "bench bo");
+    check(cudaMalloc(&d_inj, inj.size() * 4), "bench inj");
+    check(cudaMalloc(&d_lo, (size_t) T * LR * 4), "bench lo");
+    check(cudaMalloc(&d_rs, (size_t) T * HC * 4), "bench rs");
+    check(cudaMalloc(&d_inj_out, (size_t) T * HC * 4), "bench inject");
+    check(cudaMalloc(&d_mixed, (size_t) T * N * 4), "bench mixed");
+    check(cudaMalloc(&d_xn, (size_t) T * D * 4), "bench xn");
+    check(cudaMemcpy(d_r, r.data(), r.size() * 4, cudaMemcpyHostToDevice), "bench copy R");
+    check(cudaMemcpy(d_bo, bo.data(), bo.size() * 4, cudaMemcpyHostToDevice), "bench copy bo");
+    check(cudaMemcpy(d_inj, inj.data(), inj.size() * 4, cudaMemcpyHostToDevice), "bench copy inj");
