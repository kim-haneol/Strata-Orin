index 6113115..02c7cfb 100644
--- a/ggml/src/ggml-cpu/quants.c
+++ b/ggml/src/ggml-cpu/quants.c
@@ -46,6 +46,18 @@ void quantize_row_tqk7(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, in
     quantize_row_tqk7_ref(x, y, k);
 }
 
+void quantize_row_tqp5(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k) {
