{
  "exe": "${RUN}/build-l/strata",
  "args": [
    "--pack",
    "${RUN}/packs/gyro-m",
    "--native",
    "${MODEL_M}",
    "--ple-gguf",
    "${MODEL_M}",
    "--mmap-experts",
    "--expert-cache",
    "24576",
    "--expert-profile",
    "${REPO}/data/expert-profile.bin",
    "--pool-workers",
    "2",
    "--no-prefill-borrow",
    "--prefill",
    "8192",
    "--max-context",
    "262144",
    "--kv",
    "int8",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "${MTP}",
    "--conversation-cache-mib",
    "0",
    "--conversation-cache-slots",
    "4",
    "--prompt-cache",
    "6",
    "--prompt-cache-spread",
    "--vram-reserve-mib",
    "6144",
    "--short-read",
    "64",
    "--suffix-draft",
    "3",
    "--mtp-max-t",
    "4"
  ],
  "cwd": "${REPO}",
  "tokenizer": "${RUN}/packs/gyro-m/tokenizer",
  "model_name": "qwen38-flash-next-gyro-m",
  "log": "${RUNTIME}/server-engine-extension-m-20261019.log",
  "host": "127.0.0.1",
  "port": 18092,
  "env": {
    "STRATA_DENSE_F16_CACHE_MIB": "6144",
    "STRATA_CKPT_POLICY_TRACE": "1",
    "STRATA_DENSE_F16_CACHE_FLOOR_MIB": "8192"
  }
}
