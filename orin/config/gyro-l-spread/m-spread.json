{
  "exe": "${RUN}/build-spread/strata",
  "args": [
    "--pack",
    "${RUN}/packs/gyro-m",
    "--native",
    "${MODEL_M}",
    "--ple-gguf",
    "${MODEL_M}",
    "--mmap-experts",
    "--expert-cache",
    "24576",
    "--expert-profile",
    "${REPO}/data/expert-profile.bin",
    "--pool-workers",
    "2",
    "--no-prefill-borrow",
    "--prefill",
    "1024",
    "--max-context",
    "262144",
    "--kv",
    "int8",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "${MTP}",
    "--conversation-cache-mib",
    "0",
    "--conversation-cache-slots",
    "4",
    "--prompt-cache",
    "6",
    "--prompt-cache-spread"
  ],
  "cwd": "${REPO}",
  "tokenizer": "${RUN}/packs/gyro-m/tokenizer",
  "model_name": "qwen38-flash-next-gyro-m",
  "log": "${RUN}/logs/m-spread-engine.log",
  "host": "127.0.0.1",
  "port": 18094,
  "env": {
    "STRATA_DENSE_F16_CACHE_MIB": "0",
    "STRATA_CKPT_POLICY_TRACE": "1"
  }
}
